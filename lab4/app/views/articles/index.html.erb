<p style="color: green"><%= notice %></p>

<% content_for :title, "Articles" %>

<h1>Articles</h1>
<div id="articles">
  <% @articles.each do |article| %>
    <%= render article %>
    <p>
      <%= link_to "Show this article", article %>
      <%= button_to "Report Article", report_article_path(article), method: :post, class: "btn-report" if article.user != current_user%>
    </p>
  <% end %>
</div>

<%= link_to "New article", new_article_path if user_signed_in? %>
